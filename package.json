{
  "name": "@charlesponti/waveform-react",
  "version": "0.1.0",
  "description": "A voice-reactive orb of dots, and the interactive explainer of the maths behind it, as React components.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/waveform-react.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "dev": "vite --config vite.demo.config.ts",
    "build": "vite build && tsc -p tsconfig.build.json",
    "build:demo": "vite build --config vite.demo.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm run coverage && npm run build",
    "coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "keywords": [
    "react",
    "audio",
    "visualizer",
    "spectrum",
    "orb",
    "canvas",
    "waveform",
    "spectrogram",
    "voice"
  ],
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^3.2.7",
    "jsdom": "^30.1.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "5.9",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/charlesponti/waveform-react.git"
  },
  "homepage": "https://github.com/charlesponti/waveform-react#readme",
  "bugs": {
    "url": "https://github.com/charlesponti/waveform-react/issues"
  },
  "author": "Charles Ponti",
  "engines": {
    "node": ">=18"
  }
}
